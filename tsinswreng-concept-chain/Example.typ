// ── 框架：文檔所有者定義，勿動 ──
#let MkR(display, descr)={
	figure(descr)
}
#let R(cont)={}

// ── 概念鏈：登記順序 = 閱讀順序 ──
// 強烈建議按照 先聲明, 後引用 的順序, 不要前向引用 搞亂順序
// 引用已登記的條目直接寫 @名字 (用得最多)
// 引用後文纔登記的條目寫 #R[@名字] (不建議)
// @名字後須跟空格或標點（@會吞緊隨的漢字）

#let Terms = [
	#MkR[全局變量][
		全局變量（global variable）是指在函數外部、
		最外層作用域宣告的變量，
		通常整個程式、模組或檔案都能存取，
		生命週期從宣告開始，
		一直到程式或模組結束。

		簡單說：它不是某個函數的局部變量，
		而是大家都可以看到、可能都可以改的變量。

		（順手改它惹出的麻煩見#R[@副作用]）
	]<全局變量>

	#MkR[副作用][
		副作用（side effect）是指：
		一個函數或表達式在執行時，
		除了「計算並回傳結果」之外，
		還對外部世界或程式狀態造成了可觀察的改變，
		或與外界發生互動。

		簡單說：函數不只回傳值，
		還「順便」做了別的事。

		常見的副作用:
		- 修改@全局變量 或靜態變數
		- 修改傳入的物件、陣列、參數
		- 印出內容、寫 log
		- 讀寫檔案、資料庫
		- 發送網路請求
		- 修改 UI
		- 修改環境變數、系統狀態
		- 拋出異常、改變控制流
		- 依賴外部可變狀態，
		例如讀取當前時間、隨機數、全域設定
			（嚴格說這叫「外部依賴」而不是修改，
			但通常和副作用一起討論，
			因為它會讓函數不純。）
	]<副作用>

	#MkR[純函數][
		純函數（pure function）是函數式編程中的核心概念，
		簡單說就是：相同輸入永遠得到相同輸出，
		而且不產生任何副作用。

		一個函數要稱為純函數，
		通常要滿足兩個條件：

		確定性：只要輸入相同，
		回傳結果永遠相同。
		例如 add(2, 3) 永遠回傳 5。

		無@副作用：函數執行時，
		不修改外部狀態、不影響外界、也不依賴外部可變狀態。
		副作用包括：修改全域變量、修改傳入的物件/陣列、印出東西、寫檔案、發網路請求、讀取當前時間、使用隨機數等。
	]<純函數>
]

#Terms

